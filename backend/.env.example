# Copy to backend/.env, never commit the real file. Every setting is optional:
# without an LLM key the app runs in sample mode.

# --- LLM ----------------------------------------------------------------------------------
# Claude is used when this is set. Create a key in the Anthropic Console (Settings → API keys).
ANTHROPIC_API_KEY=
# Alternative provider; also set LLM_MODEL when using OpenAI.
OPENAI_API_KEY=

# LLM_PROVIDER=auto            # auto | anthropic | openai
# LLM_MODEL=claude-opus-5
# LLM_EFFORT=high              # low | medium | high | xhigh | max (Claude only)
# LLM_CONCURRENCY=4            # parallel LLM calls per review
# LLM_MAX_ATTEMPTS=3           # attempts per chunk when output fails validation
# LLM_MAX_OUTPUT_TOKENS=32000
# Prices for models not in app/llm/pricing.py (USD per million tokens), for cost tracking:
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=

# --- GitHub -------------------------------------------------------------------------------
# Optional for public repos (raises the rate limit from 60 to 5,000 requests/hour).
# Required for private repos. A fine-grained token with read-only "Pull requests"
# and "Contents" access is enough, ReviewMind never writes to GitHub.
GITHUB_TOKEN=
# Shared secret for POST /api/github/webhook; the endpoint is disabled while this is empty.
GITHUB_WEBHOOK_SECRET=

# --- Diff handling ------------------------------------------------------------------------
# CHUNK_MAX_LINES=400              # diff lines sent to the LLM per call
# MAX_CHANGED_LINES_PER_FILE=1500  # larger files are skipped as likely generated
# MAX_REVIEWABLE_FILES=40

# --- Storage and security -----------------------------------------------------------------
# DATABASE_URL=sqlite+aiosqlite:///path/to/reviewmind.db
# Fernet key that encrypts stored repository tokens. Leave empty locally and one is generated
# into data/secret.key (owner-only permissions). Generate one for any shared environment with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Assumption behind the "review time saved" estimate, in minutes per changed file.
# MINUTES_PER_FILE_MANUAL_REVIEW=6
